{
  "network_id": "agentic-devsecops-guard-mesh",
  "protocol": "open-agentic-web-nanda-v0.2",
    "llm": {
    "mode": "bring-your-own-key",
    "note": "User brings his own key, his own model, his own provider. App does not supply tokens. Judges pay for their own LLM tokens.",
    "supported": ["OpenAI", "Claude", "Groq", "DeepSeek", "Qwen 2.5 3B Local", "Otari Local Gateway"],
    "small_model_note": "Supports small 3B-parameter model locally. Each agent has one simple task so small models work well."
  },
  "consent": {
    "rule": "Every time this site connects to another agent network, it must ask the user: Do you want to allow this agent to connect to another agent network? [Allow] [Deny]",
    "irreversible_action_rule": "If agent takes irreversible action on another website, show consent pop-up first."
  },
  "built_on": "Android mobile only, GitHub Mobile App, No laptop. Designed mobile-first for limited connectivity.",
  "entry_agent": "orchestrator-agent",
  "nodes": [
    {
      "id": "orchestrator-agent",
      "role": "Coordinator & Policy Router",
      "execution": "in-browser-runtime",
      "delegates_to": ["zerotrust-sec-agent", "cloudcost-finops-agent", "autofix-remediation-agent"]
    },
    {
      "id": "zerotrust-sec-agent",
      "role": "CVE, CIS Benchmark & Secrets Auditor",
      "checks": ["OPEN_INGRESS_CIDR", "HARDCODED_SECRETS", "UNENCRYPTED_S3", "IAM_WILDCARD_PRIVILEGE"]
    },
    {
      "id": "cloudcost-finops-agent",
      "role": "Cloud Compute Right-Sizing & Savings Estimator",
      "checks": ["OVERSIZED_EC2_INSTANCE", "GRAVITON_ARM_MIGRATION"]
    },
    {
      "id": "autofix-remediation-agent",
      "role": "Automated Hardened HCL Code Synthesizer",
      "output": "production-ready-terraform"
    }
  ],
  "edges": [
    { "from": "orchestrator-agent", "to": "zerotrust-sec-agent", "event": "SCAN_SECURITY" },
    { "from": "zerotrust-sec-agent", "to": "cloudcost-finops-agent", "event": "HANDOFF_COST_AUDIT" },
    { "from": "cloudcost-finops-agent", "to": "autofix-remediation-agent", "event": "SYNTHESIZE_PATCH" },
    { "from": "autofix-remediation-agent", "to": "orchestrator-agent", "event": "RETURN_VERIFIED_REPORT" }
  ]
}
